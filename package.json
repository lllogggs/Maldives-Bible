{
  "name": "maldives-bible",
  "homepage": "https://www.maldivesbible.com/",
  "version": "1.0.0",
  "description": "A comprehensive guide to Maldives resorts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./scripts/post-build.mjs",
    "vercel-build": "npm install --include=dev && npm run build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "generate-data": "node ./scripts/generate-resorts-json.js",
    "check:supabase": "node ./scripts/check-supabase-connection.mjs"
  },
  "keywords": [
    "react",
    "gemini",
    "maldives"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.25.0",
    "@supabase/supabase-js": "^2.48.0",
    "dotenv": "^17.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vercel/node": "^3.1.2",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
