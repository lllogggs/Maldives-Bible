{
  "name": "maldives-bible",
  "homepage": "https://www.maldivesbible.com/",
  "version": "1.0.0",
  "description": "한국 커플을 위한 몰디브 신혼여행 리조트 비교 데이터베이스.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node ./scripts/post-build.mjs",
    "vercel-build": "npm install --include=dev && npm run build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "generate-data": "node ./scripts/generate-resorts-json.js",
    "reviews:collect": "node ./scripts/naver-reviews/collect.mjs",
    "reviews:init": "node ./scripts/naver-reviews/init-curation.mjs",
    "reviews:merge": "node ./scripts/naver-reviews/merge-parts.mjs",
    "reviews:apply-verified": "node ./scripts/naver-reviews/apply-verified-sources.mjs",
    "reviews:validate": "node ./scripts/naver-reviews/compile.mjs --check",
    "reviews:compile": "node ./scripts/naver-reviews/compile.mjs",
    "reviews:test": "node --test ./scripts/naver-reviews/*.test.mjs",
    "seo:validate": "node ./scripts/validate-seo-build.mjs",
    "supabase:projects": "supabase projects list",
    "supabase:link": "supabase link",
    "supabase:migrations": "supabase migration list",
    "supabase:push": "supabase db push"
  },
  "keywords": [
    "몰디브 신혼여행 처음 준비",
    "몰디브 리조트 선택 기준",
    "몰디브 신혼여행 비용",
    "몰디브 신혼여행 일정",
    "몰디브 신혼여행 리조트 비교",
    "몰디브 리조트 이동수단",
    "몰디브 워터빌라 비치빌라 차이"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.25.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.1.1",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.2.2",
    "vite": "^8.1.3"
  }
}
