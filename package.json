{
  "name": "maldives-bible",
  "homepage": "https://www.maldivesbible.com/",
  "version": "1.0.0",
  "description": "한국 커플을 위한 몰디브 신혼여행 리조트 비교 데이터베이스.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./scripts/post-build.mjs",
    "vercel-build": "npm install --include=dev && npm run build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "generate-data": "node ./scripts/generate-resorts-json.js",
    "check:supabase": "node ./scripts/check-supabase-connection.mjs"
  },
  "keywords": [
    "몰디브 신혼여행 리조트 비교",
    "몰디브 신혼여행 워터빌라 개인풀",
    "몰디브 신혼여행 보트 이동",
    "몰디브 수상비행기 리조트 비교",
    "몰디브 스노클링 좋은 리조트"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.25.0",
    "@supabase/supabase-js": "^2.48.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.2.2",
    "vite": "^8.1.3"
  }
}
