GEMINI_API_KEY=""
RESORT_PROFILE_TOKEN_SECRET=""

# Server-only Supabase credentials for shared resort like counts.
# Never expose the service-role key with a VITE_ prefix.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only NAVER API HUB credentials. Never use a VITE_ prefix.
NAVER_API_HUB_CLIENT_ID=""
NAVER_API_HUB_CLIENT_SECRET=""

# Vercel Marketplace KV usually exposes these names.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Upstash dashboard credentials also work with these names.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

RESORT_PREFERENCES_PROFILE_ID="public"
RESORT_PREFERENCES_ALLOWED_ORIGINS="https://<your-domain>.vercel.app"
VITE_PREFERENCES_API_BASE_URL="https://<your-domain>.vercel.app"
VITE_ENABLE_REMOTE_STATE_IN_DEV="false"
VITE_GOOGLE_SITE_VERIFICATION=""

# Private /admin/analytics dashboard. Use a unique password with 12+ characters.
ANALYTICS_ADMIN_PASSWORD=""
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_JSON_BASE64=""
ANALYTICS_CACHE_TTL_SECONDS="300"

# Alternative to GA4_SERVICE_ACCOUNT_JSON_BASE64.
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""
